{
  "name": "family-vault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Family Vault — a PWA for families to store important documents with expiry reminders.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ship": "vitest run tests/tasks.test.ts tests/contacts-sync.test.ts tests/device-lock.test.ts tests/webauthn.test.ts tests/home-copy.test.ts tests/gestures.test.ts tests/cron-schedule.test.ts tests/email.test.ts tests/r2-upload.test.ts tests/currency-email.test.ts tests/worker.test.ts",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply family-vault-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-vault-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@tanstack/react-query": "5.101.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "jose": "6.2.3",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.0",
    "@cloudflare/workers-types": "4.20260607.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "0.31.10",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.8",
    "wrangler": "4.98.0"
  },
  "engines": {
    "node": ">=20"
  }
}
