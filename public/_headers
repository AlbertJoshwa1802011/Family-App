# Cloudflare static-asset response headers (applied to the SPA/document responses,
# which the ASSETS binding serves — Hono secureHeaders only covers /api/*).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  # connect-src MUST allow Google Drive resumable upload hosts — the browser
  # PUTs file bytes straight to the Location URL from upload-url (never via the
  # Worker). `connect-src 'self'` alone blocks that PUT and Safari reports it as
  # the opaque TypeError "Load failed".
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://lh3.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://www.googleapis.com https://*.googleapis.com; manifest-src 'self'; worker-src 'self'
