{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // When using @cloudflare/vite-plugin, do NOT set `assets.directory` here — the plugin
  // injects the built client directory at build time. `run_worker_first` ensures /api/*
  // hits the Worker before the SPA fallback can swallow it (so unknown /api routes get a
  // JSON 404, not index.html).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-vault-db",
      "database_id": "518a69d5-a539-4009-86a7-b9380627b1b4",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "bcb22812f2ec49bab095196ff2267e59"
    }
  ],
  // Document file bytes (passports, insurance PDFs, etc.).
  // PENDING laptop: Cloudflare account must enable R2 in the Dashboard first
  // (R2 requires adding a payment method — free tier still applies after).
  // Then uncomment this block and run:
  //   npx wrangler r2 bucket create family-vault-files
  // Until then, uploads fall back to Google Drive when connected (also pending).
  // "r2_buckets": [
  //   {
  //     "binding": "FILES",
  //     "bucket_name": "family-vault-files"
  //   }
  // ],
  "triggers": {
    // 09:00 Asia/Kolkata (UTC+5:30) every day. Cloudflare cron is UTC.
    // This Worker scheduled() handler runs whether or not anyone is logged in
    // or has the app open — expiry, event, and commitment reminder emails
    // plus in-app notifications are written from here.
    "crons": ["30 3 * * *"]
  },
  "vars": {
    "APP_URL": "https://fam.connect-cloud.workers.dev"
  }
}
